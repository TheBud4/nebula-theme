  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7C7C86",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#C355FF"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.character",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#4AFF6B"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#0FF0DC"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#FFD23F"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#4A85FF"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF4570"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#BDBDC2"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#CFCFD6"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FF4570"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFD23F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#BDBDC2"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#4AFF6B",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#CFCFD6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#BDBDC2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#0FF0DC"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#4A85FF"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#4A85FF",
    "type.class": "#4A85FF",
    "type.interface": "#4A85FF",
    "type.enum": "#4A85FF",
    "type.defaultLibrary": "#4A85FF",
    "function": "#0FF0DC",
    "function.declaration": "#0FF0DC",
    "variable.readonly": {
      "foreground": "#FFD23F",
      "fontStyle": "italic"
    },
    "variable.static": {
      "foreground": "#C355FF"
    },
    "variable.declaration": "#BDBDC2",
    "parameter": "#CFCFD6",
    "parameter.declaration": "#CFCFD6",
    "property": "#CFCFD6",
    "property.declaration": "#CFCFD6",
    "keyword.deprecated": {
      "foreground": "#FF4570",
      "fontStyle": "strikethrough"
    },
    "keyword.static": {
      "foreground": "#C355FF"
    },
    "keyword.readonly": {
      "foreground": "#FFD23F",
      "fontStyle": "italic"
    },
    "modifier.readonly": {
      "foreground": "#FFD23F",
      "fontStyle": "italic"
    }
  },
  "semanticHighlighting": true
}
