  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#9898A4",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#FF8F66"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.character",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#B5E36F"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#FFB347"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#F79AD6"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#6FCFFF"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF6B7A"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#CFCFD6"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#E0E0E6"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FF6B7A"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFB347",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#CFCFD6"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#FFB347",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#E0E0E6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#CFCFD6",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#5EE0C8"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#6FCFFF"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#6FCFFF",
    "type.class": "#6FCFFF",
    "type.interface": "#6FCFFF",
    "type.enum": "#6FCFFF",
    "type.defaultLibrary": "#6FCFFF",
    "function": "#FFB347",
    "function.declaration": "#FFB347",
    "variable.readonly": {
      "foreground": "#F79AD6",
      "fontStyle": "italic"
    },
    "variable.static": {
      "foreground": "#FF8F66"
    },
    "variable.declaration": "#CFCFD6",
    "parameter": "#E0E0E6",
    "parameter.declaration": "#E0E0E6",
    "property": "#E0E0E6",
    "property.declaration": "#E0E0E6",
    "keyword.deprecated": {
      "foreground": "#FF6B7A",
      "fontStyle": "strikethrough"
    },
    "keyword.static": {
      "foreground": "#FF8F66"
    },
    "keyword.readonly": {
      "foreground": "#F79AD6",
      "fontStyle": "italic"
    },
    "modifier.readonly": {
      "foreground": "#F79AD6",
      "fontStyle": "italic"
    }
  },
  "semanticHighlighting": true
}
