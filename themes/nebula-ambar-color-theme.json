  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8F8F9B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.control",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#FF8A5B"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.character",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A8E063"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic"
      ],
      "settings": {
        "foreground": "#FFC857"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#F58FD0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#5CC8FF"
      }
    },
    {
      "scope": [
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.decorator",
        "invalid"
      ],
      "settings": {
        "foreground": "#FF5C6C"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#C6C6CC"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "variable.other.property",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D8D8DE"
      }
    },
    {
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#FF5C6C"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#FFC857",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#C6C6CC"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#FFC857",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D8D8DE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C6C6CC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#5EE0C8"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#5CC8FF"
      }
    }
  ],
  "semanticTokenColors": {
    "type": "#5CC8FF",
    "type.class": "#5CC8FF",
    "type.interface": "#5CC8FF",
    "type.enum": "#5CC8FF",
    "type.defaultLibrary": "#5CC8FF",
    "function": "#FFC857",
    "function.declaration": "#FFC857",
    "variable.readonly": {
      "foreground": "#F58FD0",
      "fontStyle": "italic"
    },
    "variable.static": {
      "foreground": "#FF8A5B"
    },
    "variable.declaration": "#C6C6CC",
    "parameter": "#D8D8DE",
    "parameter.declaration": "#D8D8DE",
    "property": "#D8D8DE",
    "property.declaration": "#D8D8DE",
    "keyword.deprecated": {
      "foreground": "#FF5C6C",
      "fontStyle": "strikethrough"
    },
    "keyword.static": {
      "foreground": "#FF8A5B"
    },
    "keyword.readonly": {
      "foreground": "#F58FD0",
      "fontStyle": "italic"
    },
    "modifier.readonly": {
      "foreground": "#F58FD0",
      "fontStyle": "italic"
    }
  },
  "semanticHighlighting": true
}
