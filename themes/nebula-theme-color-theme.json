  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#6A6280", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.expression"],
      "settings": { "foreground": "#B45AFF" }
    },
    {
      "scope": ["string", "string.quoted", "constant.character", "punctuation.definition.string"],
      "settings": { "foreground": "#5AEB71" }
    },
    {
      "scope": ["entity.name.function", "support.function", "meta.function-call.generic"],
      "settings": { "foreground": "#22E0D0" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"],
      "settings": { "foreground": "#FFC857" }
    },
    {
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"],
      "settings": { "foreground": "#5B8CFF" }
    },
    {
      "scope": ["meta.decorator", "entity.name.function.decorator", "punctuation.decorator", "invalid"],
      "settings": { "foreground": "#FF5C7A" }
    },
    {
      "scope": ["variable", "variable.other", "meta.definition.variable"],
      "settings": { "foreground": "#ACA8A5" }
    },
    {
      "scope": ["variable.parameter", "variable.other.property", "meta.object-literal.key"],
      "settings": { "foreground": "#F2EFEC" }
    },
    {
      "scope": ["entity.name.tag", "punctuation.definition.tag"],
      "settings": { "foreground": "#FF5C7A" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#FFC857", "fontStyle": "italic" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#ACA8A5" }
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "settings": { "foreground": "#5AEB71", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#F2EFEC", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#ACA8A5", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.inline.raw", "markup.fenced_code"],
      "settings": { "foreground": "#22E0D0" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#5B8CFF" }
    }
  ],
  "semanticTokenColors": {
    "type": "#5B8CFF",
    "type.class": "#5B8CFF",
    "type.interface": "#5B8CFF",
    "type.enum": "#5B8CFF",
    "type.defaultLibrary": "#5B8CFF",
    "function": "#22E0D0",
    "function.declaration": "#22E0D0",
    "variable.readonly": { "foreground": "#FFC857", "fontStyle": "italic" },
    "variable.static": { "foreground": "#B45AFF" },
    "variable.declaration": "#ACA8A5",
    "parameter": "#F2EFEC",
    "parameter.declaration": "#F2EFEC",
    "property": "#F2EFEC",
    "property.declaration": "#F2EFEC",
    "keyword.deprecated": { "foreground": "#FF5C7A", "fontStyle": "strikethrough" },
    "keyword.static": { "foreground": "#B45AFF" },
    "keyword.readonly": { "foreground": "#FFC857", "fontStyle": "italic" },
    "modifier.readonly": { "foreground": "#FFC857", "fontStyle": "italic" }
  },
  "semanticHighlighting": true
}
